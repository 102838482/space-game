<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>太空射擊遊戲</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: Arial, sans-serif;
        }
        
        #game-container {
            position: relative;
        }
        
        #game-canvas {
            border: 2px solid #333;
            background-color: #111;
        }
        
        #game-ui {
            position: absolute;
            top: 10px;
            left: 10px;
            color: white;
            font-size: 18px;
        }
        
        #start-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
        }
        
        #start-button {
            padding: 10px 20px;
            font-size: 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
        }
        
        #game-over {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
        }
        
        #restart-button {
            padding: 10px 20px;
            font-size: 20px;
            background-color: #f44336;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div id="game-container">
        <canvas id="game-canvas" width="600" height="800"></canvas>
        
        <div id="game-ui">
            分數: <span id="score">0</span> | 
            生命: <span id="lives">3</span>
        </div>
        
        <div id="start-screen">
            <h1>太空射擊遊戲</h1>
            <p>使用方向鍵移動，空格鍵射擊</p>
            <button id="start-button">開始遊戲</button>
        </div>
        
        <div id="game-over">
            <h1>遊戲結束</h1>
            <p>最終分數: <span id="final-score">0</span></p>
            <button id="restart-button">再玩一次</button>
        </div>
    </div>

    <script>
        // 遊戲變數
        const canvas = document.getElementById('game-canvas');
        const ctx = canvas.getContext('2d');
        const scoreElement = document.getElementById('score');
        const livesElement = document.getElementById('lives');
        const startScreen = document.getElementById('start-screen');
        const gameOverScreen = document.getElementById('game-over');
        const finalScoreElement = document.getElementById('final-score');
        const startButton = document.getElementById('start-button');
        const restartButton = document.getElementById('restart-button');
        
        let score = 0;
        let lives = 3;
        let gameRunning = false;
        let animationId;
        
        // 玩家設定
        const player = {
            x: canvas.width / 2 - 25,
            y: canvas.height - 100,
            width: 50,
            height: 50,
            speed: 5,
            color: '#3498db',
            bullets: [],
            lastShot: 0,
            shootDelay: 300
        };
        
        // 敵人設定
        const enemies = [];
        let enemySpawnRate = 1000; // 毫秒
        let lastEnemySpawn = 0;
        
        // 爆炸效果
        const explosions = [];
        
        // 鍵盤控制
        const keys = {
            ArrowLeft: false,
            ArrowRight: false,
            ArrowUp: false,
            ArrowDown: false,
            ' ': false
        };
        
        // 事件監聽
        startButton.addEventListener('click', startGame);
        restartButton.addEventListener('click', startGame);
        
        document.addEventListener('keydown', (e) => {
            if (keys.hasOwnProperty(e.key)) {
                keys[e.key] = true;
            }
        });
        
        document.addEventListener('keyup', (e) => {
            if (keys.hasOwnProperty(e.key)) {
                keys[e.key] = false;
            }
        });
        
        // 開始遊戲
        function startGame() {
            score = 0;
            lives = 3;
            player.bullets = [];
            enemies.length = 0;
            explosions.length = 0;
            
            scoreElement.textContent = score;
            livesElement.textContent = lives;
            
            startScreen.style.display = 'none';
            gameOverScreen.style.display = 'none';
            gameRunning = true;
            
            lastEnemySpawn = Date.now();
            
            gameLoop();
        }
        
        // 遊戲主循環
        function gameLoop() {
            if (!gameRunning) return;
            
            update();
            render();
            
            animationId = requestAnimationFrame(gameLoop);
        }
        
        // 更新遊戲狀態
        function update() {
            const now = Date.now();
            
            // 玩家移動
            if (keys.ArrowLeft && player.x > 0) {
                player.x -= player.speed;
            }
            if (keys.ArrowRight && player.x < canvas.width - player.width) {
                player.x += player.speed;
            }
            if (keys.ArrowUp && player.y > 0) {
                player.y -= player.speed;
            }
            if (keys.ArrowDown && player.y < canvas.height - player.height) {
                player.y += player.speed;
            }
            
            // 玩家射擊
            if (keys[' '] && now - player.lastShot > player.shootDelay) {
                player.bullets.push({
                    x: player.x + player.width / 2 - 2.5,
                    y: player.y,
                    width: 5,
                    height: 15,
                    speed: 7,
                    color: '#f1c40f'
                });
                player.lastShot = now;
            }
            
            // 更新子彈
            for (let i = player.bullets.length - 1; i >= 0; i--) {
                player.bullets[i].y -= player.bullets[i].speed;
                
                // 移除超出畫面的子彈
                if (player.bullets[i].y < 0) {
                    player.bullets.splice(i, 1);
                }
            }
            
            // 生成敵人
            if (now - lastEnemySpawn > enemySpawnRate) {
                spawnEnemy();
                lastEnemySpawn = now;
                
                // 隨機調整生成速率
                enemySpawnRate = Math.max(300, 1500 - score * 2);
            }
            
            // 更新敵人
            for (let i = enemies.length - 1; i >= 0; i--) {
                enemies[i].y += enemies[i].speed;
                
                // 敵人超出畫面
                if (enemies[i].y > canvas.height) {
                    enemies.splice(i, 1);
                }
                
                // 檢測敵人與玩家碰撞
                if (checkCollision(player, enemies[i])) {
                    enemies.splice(i, 1);
                    lives--;
                    livesElement.textContent = lives;
                    
                    // 爆炸效果
                    explosions.push({
                        x: player.x + player.width / 2,
                        y: player.y + player.height / 2,
                        radius: 30,
                        alpha: 1,
                        color: '#e74c3c'
                    });
                    
                    if (lives <= 0) {
                        gameOver();
                    }
                }
                
                // 檢測子彈與敵人碰撞
                for (let j = player.bullets.length - 1; j >= 0; j--) {
                    if (checkCollision(player.bullets[j], enemies[i])) {
                        enemies.splice(i, 1);
                        player.bullets.splice(j, 1);
                        
                        // 爆炸效果
                        explosions.push({
                            x: enemies[i].x + enemies[i].width / 2,
                            y: enemies[i].y + enemies[i].height / 2,
                            radius: 20,
                            alpha: 1,
                            color: '#e67e22'
                        });
                        
                        score += 10;
                        scoreElement.textContent = score;
                        break;
                    }
                }
            }
            
            // 更新爆炸效果
            for (let i = explosions.length - 1; i >= 0; i--) {
                explosions[i].alpha -= 0.02;
                explosions[i].radius += 1;
                
                if (explosions[i].alpha <= 0) {
                    explosions.splice(i, 1);
                }
            }
        }
        
        // 渲染遊戲畫面
        function render() {
            // 清空畫布
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 繪製星空背景
            drawStars();
            
            // 繪製玩家
            ctx.fillStyle = player.color;
            ctx.fillRect(player.x, player.y, player.width, player.height);
            
            // 繪製子彈
            ctx.fillStyle = '#f1c40f';
            player.bullets.forEach(bullet => {
                ctx.fillRect(bullet.x, bullet.y, bullet.width, bullet.height);
            });
            
            // 繪製敵人
            enemies.forEach(enemy => {
                ctx.fillStyle = enemy.color;
                ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);
            });
            
            // 繪製爆炸效果
            explosions.forEach(explosion => {
                ctx.beginPath();
                ctx.arc(explosion.x, explosion.y, explosion.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(${hexToRgb(explosion.color)}, ${explosion.alpha})`;
                ctx.fill();
            });
        }
        
        // 生成敵人
        function spawnEnemy() {
            const size = Math.random() * 30 + 20;
            const colors = ['#e74c3c', '#9b59b6', '#1abc9c', '#f39c12'];
            
            enemies.push({
                x: Math.random() * (canvas.width - size),
                y: -size,
                width: size,
                height: size,
                speed: Math.random() * 2 + 1,
                color: colors[Math.floor(Math.random() * colors.length)]
            });
        }
        
        // 碰撞檢測
        function checkCollision(obj1, obj2) {
            return obj1.x < obj2.x + obj2.width &&
                   obj1.x + obj1.width > obj2.x &&
                   obj1.y < obj2.y + obj2.height &&
                   obj1.y + obj1.height > obj2.y;
        }
        
        // 遊戲結束
        function gameOver() {
            gameRunning = false;
            cancelAnimationFrame(animationId);
            
            finalScoreElement.textContent = score;
            gameOverScreen.style.display = 'flex';
        }
        
        // 繪製星空背景
        function drawStars() {
            ctx.fillStyle = 'white';
            
            // 固定星星位置 (簡單實現)
            const stars = [
                {x: 50, y: 100, size: 1},
                {x: 150, y: 50, size: 2},
                {x: 300, y: 80, size: 1},
                {x: 400, y: 120, size: 1},
                {x: 550, y: 70, size: 2},
                {x: 100, y: 300, size: 1},
                {x: 250, y: 350, size: 2},
                {x: 500, y: 400, size: 1},
                {x: 200, y: 500, size: 1},
                {x: 450, y: 550, size: 2},
                {x: 50, y: 700, size: 1},
                {x: 350, y: 750, size: 1},
                {x: 550, y: 720, size: 2}
            ];
            
            stars.forEach(star => {
                ctx.beginPath();
                ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
                ctx.fill();
            });
        }
        
        // 輔助函數：十六進制顏色轉RGB
        function hexToRgb(hex) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return `${r}, ${g}, ${b}`;
        }
    </script>
</body>
</html>
